# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/jalrakshak

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRE=30d

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=https://jadlrakshak-ai-adviser.vercel.app
AI_SERVICE_TIMEOUT_MS=30000

# Deployed Assistant Configuration
DEPLOYED_ASSISTANT_API_URL=https://jadlrakshak-ai-adviser.vercel.app/api/chat
DEPLOYED_ASSISTANT_API_KEY=

# Redis Cache Configuration (Optional)
REDIS_URL=redis://localhost:6379

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=jal-rakshak/reports

# Deployed Hazard Image Verification Model Service
HAZARD_VERIFICATION_URL=https://ai-report-hazard.vercel.app/verify-image
HAZARD_VERIFICATION_TIMEOUT_MS=60000
HAZARD_VERIFICATION_REQUEST_MODE=url

# Socket.IO Real-Time Configuration
SOCKET_CORS_ORIGIN=http://localhost:5173

# Email SMTP Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_app_password
EMAIL_FROM=Jal Rakshak Alert System <alerts@example.com>

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50000

# Logging Level
LOG_LEVEL=info
